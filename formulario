<!DOCTYPE html>
<html lang="pt-BR">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Polícia Civil - Recrutamento</title>


<style>

:root{

    --azul:#071b3d;
    --azul2:#0a265c;
    --discord:#5865F2;
    --verde:#27ae60;

}


*{

    box-sizing:border-box;

}



body{

    margin:0;

    min-height:100vh;

    background:
    linear-gradient(135deg,#071b3d,#0a265c);

    font-family:'Segoe UI',Arial,sans-serif;

    display:flex;

    justify-content:center;

    align-items:center;

    color:white;

}



/* LOGIN */

#login-screen{

    width:450px;

    background:rgba(0,0,0,.55);

    padding:45px;

    border-radius:20px;

    text-align:center;

    border:2px solid var(--discord);

    box-shadow:
    0 0 25px rgba(88,101,242,.4);

}


#login-screen h1{

    margin:0;

    font-size:38px;

}


#login-screen h2{

    color:#00f2ff;

    font-size:18px;

    letter-spacing:2px;

}



.discord-btn{

    display:block;

    margin-top:25px;

    background:var(--discord);

    color:white;

    padding:15px;

    border-radius:10px;

    text-decoration:none;

    font-weight:bold;

    transition:.3s;

}


.discord-btn:hover{

    transform:scale(1.05);

    background:#4752c4;

}




/* APLICATIVO */


#app{

    display:none;

    width:900px;

    background:rgba(0,0,0,.45);

    border-radius:20px;

    overflow:hidden;

    box-shadow:0 10px 40px #000;

}



/* BARRA USUARIO */


#user-bar{

    display:flex;

    align-items:center;

    gap:15px;

    padding:15px;

    background:rgba(0,0,0,.4);

}


#user-avatar{

    width:45px;

    height:45px;

    border-radius:50%;

    border:2px solid var(--discord);

}


#logout{

    margin-left:auto;

    background:#ff4757;

    border:none;

    color:white;

    padding:8px 15px;

    border-radius:6px;

    cursor:pointer;

}



/* FORMULARIO */


.container{

    background:white;

    color:black;

    padding:35px;

}



.container h1{

    text-align:center;

    color:#071b3d;

}



.linha{

    border-bottom:2px solid #071b3d;

    margin-bottom:25px;

}




label{

    display:block;

    font-weight:bold;

    margin-top:15px;

}



input,
textarea,
select{


    width:100%;

    margin-top:5px;

    padding:12px;

    border-radius:8px;

    border:1px solid #ccc;

    font-family:inherit;


}



textarea{

    height:100px;

    resize:none;

}




.enviar{

    margin-top:25px;

    width:100%;

    height:55px;

    background:var(--verde);

    color:white;

    border:0;

    border-radius:10px;

    font-weight:bold;

    cursor:pointer;

    font-size:16px;

}


.enviar:hover{

    background:#219150;

}



.aviso{

    margin-top:20px;

    padding:15px;

    background:#eee;

    border-radius:8px;

    font-size:13px;

}



</style>

</head>


<body onload="checkLogin()">



<div id="login-screen">


<h1>🚔 POLÍCIA CIVIL</h1>

<h2>SISTEMA DE RECRUTAMENTO</h2>


<p>

Autentique-se com seu Discord para iniciar sua inscrição.

</p>



<a class="discord-btn"

href="https://discord.com/oauth2/authorize?client_id=1482774609685119187&response_type=token&redirect_uri=https%3A%2F%2Frafaguild4-pixel.github.io%2Frecrutamento%2F&scope=identify">


🔵 LOGIN COM DISCORD


</a>


</div>

</div>


<div id="app">


<div id="user-bar">


<img id="user-avatar">


<div>

<span>Candidato:</span>

<strong id="user-name">
Carregando...
</strong>

</div>



<button id="logout" onclick="logout()">

SAIR

</button>


</div>




<div class="container">


<h1>
🚔 Ficha de Recrutamento
</h1>


<div class="linha"></div>




<label>

👤 Nome RP

<input 
type="text"
id="nomeRP"
placeholder="Digite seu nome no servidor">

</label>





<label>

🆔 ID no Servidor

<input 
type="text"
id="idServidor"
placeholder="Ex: 1234">

</label>





<label>

🎂 Idade

<input 
type="number"
id="idade"
placeholder="Digite sua idade">

</label>





<label>

🎮 Quantas horas possui de RP?

<input 
type="text"
id="horasRP"
placeholder="Ex: 500 horas">

</label>





<label>

👮 Já participou de alguma corporação?

<select id="experiencia">


<option value="Não">
Não
</option>


<option value="Sim - Polícia Militar">
Sim - Polícia Militar
</option>


<option value="Sim - Polícia Civil">
Sim - Polícia Civil
</option>


<option value="Sim - Outra corporação">
Sim - Outra corporação
</option>


</select>


</label>





<label>

📚 Experiências / Cursos / Conhecimentos


<textarea 
id="experiencias"
placeholder="Informe suas experiências anteriores...">

</textarea>


</label>





<label>

⏰ Disponibilidade de horário


<input
type="text"
id="disponibilidade"
placeholder="Ex: Todos os dias após 18h">

</label>





<label>

📝 Por que deseja ingressar na Polícia Civil?


<textarea
id="motivo"
placeholder="Explique o motivo da sua candidatura...">

</textarea>


</label>





<label>

📖 Conhecimento da documentação


<select id="documentacao">


<option value="Sim">
Sim, li toda documentação
</option>


<option value="Não">
Não li a documentação
</option>


</select>


</label>






<div class="aviso">


⚠️ Ao enviar sua inscrição, todas as informações serão encaminhadas para a equipe de recrutamento.


</div>





<button 
class="enviar"
onclick="enviarFormulario()">


🚔 ENVIAR INSCRIÇÃO


</button>



</div>



</div>

<script>


// COLOQUE SEU WEBHOOK DO DISCORD AQUI
const WEBHOOK_URL = "https://discord.com/api/webhooks/1531035867978793051/FS7jYRHAJ6KuZwn_1SsnfNphbOBHpLZ0T_DLe9r70AKC-0-p2iQBcHhFzqf9EZCcFyj1";



// LOGIN DISCORD

function checkLogin(){


    const fragment = new URLSearchParams(
        window.location.hash.substring(1)
    );


    const token = fragment.get("access_token");


    if(!token){

        return;

    }



    fetch("https://discord.com/api/users/@me",
    {

        headers:{

            authorization:`Bearer ${token}`

        }

    })


    .then(response => response.json())


    .then(user =>{


        window.discordUser = user;



        document.getElementById("login-screen").style.display="none";


        document.getElementById("app").style.display="block";



        document.getElementById("user-name").innerText =
        user.username;



        document.getElementById("user-avatar").src =

        `https://cdn.discordapp.com/avatars/${user.id}/${user.avatar}.png`;



    })


    .catch(()=>{


        logout();


    });



}




// SAIR

function logout(){


    window.location.hash="";

    location.reload();


}





// ENVIAR FORMULÁRIO


function enviarFormulario(){



    if(!window.discordUser){


        alert("Faça login novamente.");


        return;


    }





    const dados = {


        nome:
        document.getElementById("nomeRP").value,


        id:
        document.getElementById("idServidor").value,


        idade:
        document.getElementById("idade").value,


        horas:
        document.getElementById("horasRP").value,


        experiencia:
        document.getElementById("experiencia").value,


        cursos:
        document.getElementById("experiencias").value,


        horario:
        document.getElementById("disponibilidade").value,


        motivo:
        document.getElementById("motivo").value,


        documento:
        document.getElementById("documentacao").value


    };





    if(
        !dados.nome ||
        !dados.id ||
        !dados.idade ||
        !dados.motivo
    ){

        alert("Preencha todos os campos obrigatórios.");

        return;

    }





    fetch(WEBHOOK_URL,
    {


        method:"POST",


        headers:{

            "Content-Type":"application/json"

        },


        body:JSON.stringify({


            embeds:[{


                title:"🚔 NOVO RECRUTAMENTO - POLÍCIA CIVIL",


                color:3447003,



                thumbnail:{

                    url:
                    `https://cdn.discordapp.com/avatars/${window.discordUser.id}/${window.discordUser.avatar}.png`

                },



                fields:[


                    {

                    name:"👤 Discord",

                    value:`<@${window.discordUser.id}>`

                    },


                    {

                    name:"🪪 Nome RP",

                    value:dados.nome

                    },


                    {

                    name:"🆔 ID Servidor",

                    value:dados.id

                    },


                    {

                    name:"🎂 Idade",

                    value:dados.idade

                    },


                    {

                    name:"🎮 Horas de RP",

                    value:dados.horas || "Não informado"

                    },


                    {

                    name:"👮 Experiência",

                    value:dados.experiencia

                    },


                    {

                    name:"📚 Cursos / Conhecimentos",

                    value:dados.cursos || "Não informado"

                    },


                    {

                    name:"⏰ Disponibilidade",

                    value:dados.horario || "Não informado"

                    },


                    {

                    name:"📖 Documentação",

                    value:dados.documento

                    },


                    {

                    name:"📝 Motivo",

                    value:dados.motivo

                    }



                ],



                footer:{

                    text:"Sistema de Recrutamento"

                },



                timestamp:new Date()


            }]


        })


    })



    .then(()=>{


        alert("✅ Inscrição enviada com sucesso!");

        location.reload();


    })


    .catch(error=>{


        console.log(error);


        alert("❌ Erro ao enviar inscrição.");


    });



}



</script>


</body>

</html>
